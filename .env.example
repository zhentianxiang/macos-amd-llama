# 如果需要，在运行scripts/run.sh之前重写这些变量
# MODEL_PATH=/absolute/path/to/model.gguf
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
EMBEDDING_HOST=127.0.0.1
EMBEDDING_PORT=8092
MODEL_ALIAS=gemma-4-12b-it-qat-q4_0
EMBEDDING_MODEL_PATH=./models/gemma-4-12b-it-qat-q4_0.gguf
EMBEDDING_MMPROJ_PATH=./models/mmproj-gemma-4-12b-it-qat-q4_0.gguf
EMBEDDING_CTX_SIZE=4096
EMBEDDING_GPU_LAYERS=99
CTX_SIZE=16384
CHAT_MAX_TOKENS=1024
CHAT_ENABLE_THINKING=false
GPU_LAYERS=99
BUILD_JOBS=6

# Web 控制台与本机控制代理
DASHBOARD_WEB_HOST=127.0.0.1
DASHBOARD_WEB_PORT=3000
DASHBOARD_AGENT_HOST=127.0.0.1
DASHBOARD_AGENT_PORT=8090

# 从其他电脑访问时，填写实际的 Web 地址；多个地址使用逗号分隔。
# DASHBOARD_ALLOWED_ORIGINS=http://192.168.1.10:3000
